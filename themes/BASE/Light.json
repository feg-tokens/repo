{
  "color": {
    "background": {
      "base": {
        "value": "$palette.grey.120",
        "type": "color"
      },
      "gm-base": {
        "value": "$palette.grey.90",
        "type": "color"
      },
      "progress-bar": {
        "value": "$palette.grey.110",
        "type": "color",
        "description": "To be used on progress-bar backgrounds."
      }
    },
    "surface": {
      "primary": {
        "value": "$palette.base.white",
        "type": "color"
      },
      "secondary": {
        "value": "$palette.grey.130",
        "type": "color"
      },
      "panel": {
        "value": "$palette.base.white",
        "type": "color"
      },
      "action": {
        "value": "$palette.base.white",
        "type": "color"
      },
      "gradient": {
        "value": "linear-gradient(0deg, $color.surface.primary 0%, $color.surface.secondary 100%);",
        "type": "color"
      },
      "inverted-bw": {
        "value": "$palette.base.white",
        "type": "color"
      },
      "input": {
        "value": "$palette.grey.110",
        "type": "color"
      },
      "input-error": {
        "value": "{palette.red.140}",
        "type": "color"
      },
      "input-text-inactive": {
        "value": "$palette.grey.90",
        "type": "color"
      },
      "navigation": {
        "value": "$palette.base.white",
        "type": "color"
      }
    },
    "surface-hover": {
      "primary": {
        "value": "{color.surface.primary}",
        "type": "color",
        "$extensions": {
          "studio.tokens": {
            "modify": {
              "type": "lighten",
              "value": "0.035",
              "space": "lch"
            }
          }
        }
      },
      "secondary": {
        "value": "{color.surface.secondary}",
        "type": "color",
        "$extensions": {
          "studio.tokens": {
            "modify": {
              "type": "lighten",
              "value": "0.035",
              "space": "lch"
            }
          }
        }
      },
      "panel": {
        "value": "{color.surface.panel}",
        "type": "color",
        "$extensions": {
          "studio.tokens": {
            "modify": {
              "type": "lighten",
              "value": "0.035",
              "space": "lch"
            }
          }
        }
      },
      "action": {
        "value": "{color.surface.action}",
        "type": "color",
        "$extensions": {
          "studio.tokens": {
            "modify": {
              "type": "lighten",
              "value": "0.035",
              "space": "lch"
            }
          }
        }
      }
    },
    "content": {
      "primary": {
        "value": "$palette.base.black",
        "type": "color"
      },
      "secondary": {
        "value": "$palette.grey.30",
        "type": "color"
      },
      "tertiary": {
        "value": "$palette.grey.50",
        "type": "color"
      },
      "on-content-primary": {
        "value": "$palette.base.black",
        "type": "color"
      },
      "form-label-text": {
        "value": "$palette.base.white",
        "type": "color"
      },
      "primary-inverted": {
        "value": "$palette.base.white",
        "type": "color"
      },
      "perma-black": {
        "value": "$palette.base.black",
        "type": "color"
      },
      "perma-white": {
        "value": "$palette.base.white",
        "type": "color"
      },
      "disabled": {
        "value": "$palette.grey.90",
        "type": "color"
      },
      "error": {
        "value": "{palette.red.50}",
        "type": "color"
      },
      "placeholder": {
        "value": "{palette.grey.70}",
        "type": "color"
      }
    },
    "border": {
      "primary": {
        "value": "$palette.grey.90",
        "type": "color"
      },
      "secondary": {
        "value": "$palette.grey.120",
        "type": "color"
      },
      "tertiary": {
        "value": "$palette.grey.110",
        "type": "color"
      },
      "gm-base": {
        "value": "$palette.grey.80",
        "type": "color"
      },
      "btn-disabled": {
        "value": "$palette.grey.90",
        "type": "color"
      },
      "input": {
        "value": "$palette.grey.90",
        "type": "color"
      },
      "input-error": {
        "value": "{palette.red.60}",
        "type": "color"
      },
      "input-sucess": {
        "value": "{palette.green.50}",
        "type": "color"
      }
    },
    "overlay": {
      "scrim": {
        "value": "rgba($palette.base.black,$opacity.scrim)",
        "type": "color"
      },
      "navigation": {
        "value": "rgba( {color.surface.primary} , {opacity.glass})",
        "type": "color"
      },
      "tooltip-default": {
        "value": "rgba({palette.grey.20} , {opacity.glass})",
        "type": "color"
      },
      "gradient": {
        "value": "linear-gradient (0deg, rgba( {palette.base.black} , 0.4) 0%, rgba( {palette.base.black} , 0) 100%)",
        "type": "color"
      },
      "gradient-primary-on-avatar-edit": {
        "value": "linear-gradient (0deg, rgba( {color.surface.primary}, 0.7) 0%, rgba( {color.surface.primary} , 1) 100%)",
        "type": "color"
      }
    },
    "odd-button": {
      "default": {
        "value": "{palette.base.black}",
        "type": "color",
        "$extensions": {
          "studio.tokens": {
            "modify": {
              "type": "alpha",
              "value": "0.06",
              "space": "lch"
            }
          }
        }
      },
      "hover": {
        "value": "{palette.base.black}",
        "type": "color",
        "$extensions": {
          "studio.tokens": {
            "modify": {
              "type": "alpha",
              "value": "0.1",
              "space": "lch"
            }
          }
        }
      },
      "disabled": {
        "value": "{palette.base.black}",
        "type": "color",
        "$extensions": {
          "studio.tokens": {
            "modify": {
              "type": "alpha",
              "value": "0",
              "space": "lch"
            }
          }
        }
      }
    }
  },
  "special-surface": {
    "navigation-bar": {
      "value": {
        "fill": "{color.overlay.navigation}",
        "backgroundBlur": "8"
      },
      "type": "composition"
    },
    "gradient-primary-on-avatar-edit": {
      "value": {
        "fill": "{color.overlay.gradient-primary-on-avatar-edit}",
        "backgroundBlur": "10"
      },
      "type": "composition"
    }
  },
  "sheet": {
    "bottom": {
      "value": {
        "fill": "{color.surface.primary}",
        "paddingTop": "{space.medium}",
        "borderRadiusTopLeft": "{radius.xlarge}",
        "borderRadiusTopRight": "{radius.xlarge}",
        "borderRadiusBottomRight": "none",
        "borderRadiusBottomLeft": "none"
      },
      "type": "composition"
    }
  },
  "dialog": {
    "default": {
      "value": {
        "fill": "{color.surface.primary}",
        "verticalPadding": "{space.xlarge}",
        "horizontalPadding": "{space.xlarge}",
        "boxShadow": "{shadow.out.xlarge}",
        "borderRadius": "{radius.medium}"
      },
      "type": "composition"
    }
  },
  "pop-over": {
    "default": {
      "value": {
        "fill": "{color.surface.panel}",
        "verticalPadding": "{space.xlarge}",
        "horizontalPadding": "{space.xlarge}",
        "boxShadow": "{shadow.out.2xlarge}",
        "borderRadius": "{radius.medium}"
      },
      "type": "composition"
    }
  }
}